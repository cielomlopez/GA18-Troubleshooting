<?php
$conn = mysqli_connect("localhost","root","","class_db");

//  not enough quoates in the SQL, column name ang value na nareread ng database
// $fname = $_POST['fname'];

$fname = $_POST['fname']; // exact input

// no quotes in $fname causing error "Unknown column 'Ana'"
// $sql = "SELECT * FROM students WHERE first_name = $fname";

//must be single quotes to become string in the SQL
$sql = "SELECT * FROM students WHERE first_name = '$fname'";

/*
I've added single quotes in the $fname. 
no quotes, SQL reads the value as column name causing error. 
if 'value', SQL knows it's string search. 
so searching name using first_name as base input of user works perfectly.
*/

$res = mysqli_query($conn, $sql);
?>
